# ==============================================================================
# HostelOps Environment Variables Configuration
# ==============================================================================

# Supabase Configuration (Required for Database & Auth)
# Add these in your Netlify Site Configuration -> Environment Variables
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Gemini AI API Key (Required for Netlify Serverless Functions / AI Assistant)
# Add in Netlify Environment Variables (Server-side only)
GEMINI_API_KEY=your-gemini-api-key

# Optional Hosting / App URL
APP_URL=https://your-site-name.netlify.app

